index 0000000..24406ef
--- /dev/null
+++ b/src/solidworks_assetmate_mechdog/tools/zjzl_mates.py
@@ -0,0 +1,89 @@
+"""Read the active configuration's assembly-level Mate features."""
+from __future__ import annotations
+
+import math
+
+from ..sw_session import call_method
+from .zjzl_native import Native, execute, optional, persist, source_path
+
+
+def _cast_optional(native, read, interface):
+    return optional(lambda: native.cast(read(), interface))
+
+
+def _mate_record(native, feature, extension):
+    kind = feature.GetTypeName2()
+    suppressed = optional(feature.IsSuppressed)
+    feature_error = optional(feature.GetErrorCode2)
+    record = {"name": feature.Name, "feature_type": kind, "suppressed": suppressed,
+              "feature_code": feature_error[0] if feature_error is not None else None,
+              "feature_warning": feature_error[1] if feature_error is not None else None,
+              "mate_type": None, "alignment": None, "flipped": None, "value": None,
+              "unit": None, "entities": [], "issues": []}
+    issues = record["issues"]
+    mate = _cast_optional(native, feature.GetSpecificFeature2, "IMate2")
+    if mate is None:
+        issues.append("mate_details_unavailable")
+        return record
+    record.update(mate_type=optional(lambda: mate.Type), alignment=optional(lambda: mate.Alignment),
+                  flipped=optional(lambda: mate.Flipped))
+    count = optional(mate.GetMateEntityCount)
+    if count is None or count == 0:
+        issues.append("mate_entities_unavailable")
+    for index in range(count or 0):
+        entity = _cast_optional(native, lambda: mate.MateEntity(index), "IMateEntity2")
+        if entity is None:
+            issues.append(f"entity_{index}_unavailable")
+            record["entities"].append({"index": index, "status": "unavailable"})
+            continue
+        component = _cast_optional(native, lambda: entity.ReferenceComponent, "IComponent2")
+        reference = optional(lambda: entity.Reference)
+        record["entities"].append({
+            "index": index, "entity_type": optional(lambda: entity.ReferenceType2),
+            "component": optional(lambda: component.Name2) if component is not None else None,
+            "component_path": optional(component.GetPathName) if component is not None else None,
+            "persistent_id": persist(extension, reference) if reference is not None else None,
+            "status": "read" if reference is not None else "unavailable",
+        })
+        if reference is None:
+            issues.append(f"entity_{index}_reference_unavailable")
+    # Other mate types can carry multiple parameters. Avoid treating one as their value.
+    if kind in ("MateDistanceDim", "MateAngleDim"):
+        display = _cast_optional(native, lambda: mate.DisplayDimension, "IDisplayDimension")
+        dimension = _cast_optional(native, lambda: display.GetDimension2(0), "IDimension") if display is not None else None
+        value = optional(lambda: dimension.SystemValue) if dimension is not None else None
+        if value is None or not math.isfinite(value):
+            issues.append("value_unavailable")
+        elif kind == "MateDistanceDim":
+            record.update(value=value * 1000, unit="mm")
+        else:
+            record.update(value=math.degrees(value), unit="deg")
+    return record
+
+
+def _inspect(assembly_path):
+    path = source_path(assembly_path, (".sldasm",))
+    native = Native()
+    doc = native.document(path, 2)
+    manager = native.cast(doc.ConfigurationManager, "IConfigurationManager")
+    configuration = native.cast(manager.ActiveConfiguration, "IConfiguration")
+    extension = native.cast(doc.Extension, "IModelDocExtension")
+    groups, mates = [], []
+    raw = call_method(doc, "FirstFeature")
+    while raw is not None:
+        feature = native.cast(raw, "IFeature")
+        if feature.GetTypeName2() == "MateGroup":
+            groups.append(feature.Name)
+            current = feature.GetFirstSubFeature()
+            while current is not None:
+                child = native.cast(current, "IFeature")
+                if child.GetTypeName2().startswith("Mate"):
+                    mates.append(_mate_record(native, child, extension))
+                current = child.GetNextSubFeature()
+        raw = call_method(feature, "GetNextFeature")
+    return {"assembly_path": path, "configuration": configuration.Name, "mate_groups": groups,
+            "mates": mates, "status": "partial" if any(row["issues"] for row in mates) else "complete"}
+
+
+def inspect_mates(assembly_path):
+    return execute(_inspect, assembly_path)
diff --git a/src/solidworks_assetmate_mechdog/tools/zjzl_native.py b/src/solidworks_assetmate_mechdog/tools/zjzl_native.py
new file mode 100644
index 0000000..477f2c6
--- /dev/null
+++ b/src/solidworks_assetmate_mechdog/tools/zjzl_native.py
@@ -0,0 +1,173 @@
+"""Typed SolidWorks calls on AssetMate's existing COM session."""
+from __future__ import annotations
+
+import base64
+import math
+import os
+
+from .. import sw_session
+from .drawing import _activate
+
+
+class ZJZLError(RuntimeError):
+    def __init__(self, code, message):
+        super().__init__(message)
+        self.code = code
+
+
+def path_key(path):
+    return os.path.normcase(os.path.realpath(path)) if path else None
+
+
+def source_path(path, extensions):
+    if not os.path.isabs(path) or os.path.splitext(path)[1].lower() not in extensions:
+        raise ZJZLError("bad_input", f"Expected an absolute path to {', '.join(extensions)}")
+    return os.path.realpath(path)
+
+
+class Native:
+    def __init__(self):
+        from win32com.client import gencache
+
+        self.dynamic = sw_session.get_sw()
+        revision = sw_session.sw_version(self.dynamic)
+        if not revision:
+            raise ZJZLError("com_unavailable", "SolidWorks did not report a revision")
+        self.library = gencache.EnsureModule(
+            "{83A33D31-27C5-11CE-BFD4-00400513BB57}", 0, int(revision.split(".")[0]), 0
+        )
+        self.app = self.cast(self.dynamic, "ISldWorks")
+
+    def cast(self, obj, interface):
+        import pythoncom
+
+        if obj is None:
+            return None
+        cls = getattr(self.library, interface)
+        if isinstance(obj, cls):
+            return obj
+        dispatch = getattr(obj, "_oleobj_", obj)
+        return cls(dispatch.QueryInterface(cls.CLSID, pythoncom.IID_IDispatch))
+
+    def active(self, path, kind):
+        active = self.cast(self.app.ActiveDoc, "IModelDoc2")
+        if active is None or active.GetType() != kind or path_key(active.GetPathName()) != path_key(path):
+            return None
+        return active
+
+    def document(self, path, kind):
+        current = self.active(path, kind)
+        if current is not None:
+            return current
+        opened = self.cast(self.app.GetOpenDocumentByName(path), "IModelDoc2")
+        if opened is None:
+            opened = self.cast(sw_session.open_document(path, kind), "IModelDoc2")
+        if path_key(opened.GetPathName()) != path_key(path) or opened.GetType() != kind:
+            raise ZJZLError("document_mismatch", f"SolidWorks opened a different document for {path}")
+        for key in (path, opened.GetTitle()):
+            if self.active(path, kind) is not None:
+                break
+            _activate(self.dynamic, key)
+        current = self.active(path, kind)
+        if current is None:
+            raise ZJZLError("document_mismatch", f"Could not activate the exact document {path}")
+        return current
+
+
+def optional(call):
+    import pythoncom
+
+    try:
+        return call()
+    except (pythoncom.com_error, AttributeError, TypeError) as exc:
+        if sw_session.is_bridge_lost_error(exc) or sw_session.is_transient_com_error(exc):
+            raise
+        return None
+
+
+def execute(operation, *args):
+    try:
+        return sw_session.ok(**operation(*args))
+    except ZJZLError as exc:
+        return sw_session.error(exc.code, str(exc))
+    except Exception as exc:
+        if sw_session.is_bridge_lost_error(exc):
+            try:
+                sw_session.reconnect(reason="ZJZL COM bridge lost")
+            except Exception:
+                pass  # The next tool call can reconnect again.
+            return sw_session.error("com_bridge_lost", str(exc), "Reopen and inspect the drawing before retrying a write.")
+        return sw_session.error("zjzl_operation_failed", str(exc))
+
+
+def drawing_scope(native, path, sheet_name):
+    doc = native.document(path, sw_session.SW_DOC_DRAWING)
+    drawing = native.cast(doc, "IDrawingDoc")
+    if sheet_name is None:
+        sheet = native.cast(drawing.GetCurrentSheet(), "ISheet")
+    else:
+        if sheet_name not in (drawing.GetSheetNames() or ()):
+            raise ZJZLError("sheet_not_found", f"Drawing has no sheet named {sheet_name!r}")
+        sheet = native.cast(drawing.Sheet(sheet_name), "ISheet")
+    extension = native.cast(doc.Extension, "IModelDocExtension")
+    return doc, drawing, sheet, extension
+
+
+def model_views(native, sheet):
+    views = (native.cast(raw, "IView") for raw in (sheet.GetViews() or ()))
+    return [view for view in views if view.Type != 1]
+
+
+def named_view(native, sheet, name):
+    matches = [view for view in model_views(native, sheet) if view.GetName2() == name]
+    if len(matches) != 1:
+        raise ZJZLError("view_not_found", f"Expected one model view named {name!r} on {sheet.GetName()!r}")
+    return matches[0]
+
+
+def activate_sheet(native, drawing, sheet):
+    name = sheet.GetName()
+    current = native.cast(drawing.GetCurrentSheet(), "ISheet")
+    if current.GetName() != name and not drawing.ActivateSheet(name):
+        raise ZJZLError("sheet_activation_failed", f"Could not activate sheet {name!r}")
+
+
+def sheet_point(sheet, point):
+    properties = sheet.GetProperties2()
+    if len(point) != 2 or not all(math.isfinite(value) for value in point):
+        raise ZJZLError("bad_input", "Expected two finite sheet coordinates in metres")
+    if not (0 < point[0] < properties[5] and 0 < point[1] < properties[6]):
+        raise ZJZLError("outside_sheet", f"Position {list(point)} lies outside {sheet.GetName()!r}")
+    return (*point, 0.0)
+
+
+def save_drawing(doc):
+    saved, errors, warnings = doc.Save3(1, 0, 0)  # swSaveAsOptions_Silent
+    if not saved or errors:
+        raise ZJZLError("save_failed", f"SolidWorks Save3 returned errors={errors}, warnings={warnings}")
+    return int(warnings)
+
+
+def persist(extension, entity):
+    data = optional(lambda: extension.GetPersistReference3(entity))
+    return base64.urlsafe_b64encode(bytes(data)).decode("ascii") if data else None
+
+
+def read_reference(identifier):
+    if not identifier or len(identifier) > 65536:
+        raise ZJZLError("bad_reference", "Expected a ZJZL persistent entity identifier")
+    try:
+        return base64.b64decode(identifier, altchars=b"-_", validate=True)
+    except (ValueError, TypeError) as exc:
+        raise ZJZLError("bad_reference", "Invalid ZJZL persistent entity identifier") from exc
+
+
+def rollback_annotation(doc, extension, annotation, cause):
+    doc.ClearSelection2(True)
+    try:
+        if not annotation.Select(False) or not extension.DeleteSelection2(0):
+            doc.ClearSelection2(True)
+            if not sw_session.call_method(annotation, "Select3", False, None) or not extension.DeleteSelection2(0):
+                raise RuntimeError("SolidWorks did not delete the annotation")
+    except Exception as exc:
+        raise ZJZLError("rollback_failed", f"{cause}. Annotation cleanup failed: {exc}") from exc
diff --git a/src/solidworks_assetmate_mechdog/tools/zjzl_orthographic.py b/src/solidworks_assetmate_mechdog/tools/zjzl_orthographic.py
new file mode 100644
index 0000000..668c55a
--- /dev/null
+++ b/src/solidworks_assetmate_mechdog/tools/zjzl_orthographic.py
@@ -0,0 +1,147 @@
+"""Create native, aligned projections from an existing drawing view."""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import math
+
+from .zjzl_native import (
+    Native, ZJZLError, activate_sheet, drawing_scope, execute, model_views, named_view,
+    path_key, save_drawing, sheet_point, source_path,
+)
+
+
+# Axis of the view normal in the base view, looking from that side of the object.
+SIDES = {"right": (0, 1), "left": (0, -1), "top": (1, 1), "bottom": (1, -1)}
+
+
+def projection_positions(origin, directions, offset, first_angle):
+    if not directions or len(directions) != len(set(directions)) or set(directions) - SIDES.keys():
+        raise ZJZLError("bad_input", "Directions must be unique and chosen from top, bottom, left, right")
+    if not math.isfinite(offset) or offset <= 0:
+        raise ZJZLError("bad_input", "Projection offset must be positive and finite")
+    positions = {}
+    for direction in directions:
+        axis, sign = SIDES[direction]
+        position = list(origin[:2])
+        position[axis] += offset * sign * (-1 if first_angle else 1)
+        positions[direction] = position
+    return positions
+
+
+def transform(native, view):
+    matrix = native.cast(view.ModelToViewTransform, "IMathTransform")
+    data = tuple(matrix.ArrayData) if matrix is not None else ()
+    if len(data) < 13 or not all(math.isfinite(value) for value in data) or data[12] <= 0:
+        raise ZJZLError("view_transform_unavailable", f"Could not read transform for {view.GetName2()!r}")
+    return data
+
+
+def axis_vector(matrix, index):
+    return matrix[index:9:3]
+
+
+def select_view(extension, name):
+    return extension.SelectByID2(name, "DRAWINGVIEW", 0.0, 0.0, 0.0, False, 0, None, 0)
+
+
+def view_record(view):
+    return {"name": view.GetName2(), "position_m": list(view.Position[:2]),
+            "outline_m": list(view.GetOutline()), "configuration": view.ReferencedConfiguration}
+
+
+def check_layout(native, sheet, view):
+    name = view.GetName2()
+    left, bottom, right, top = view.GetOutline()
+    width, height = sheet.GetProperties2()[5:7]
+    if not (0 <= left < right <= width and 0 <= bottom < top <= height):
+        raise ZJZLError("view_outside_sheet", f"Outline for {name!r} does not fit on the sheet")
+    for other in model_views(native, sheet):
+        if other.GetName2() == name:
+            continue
+        x1, y1, x2, y2 = other.GetOutline()
+        if max(left, x1) < min(right, x2) and max(bottom, y1) < min(top, y2):
+            raise ZJZLError("view_overlap", f"View {name!r} overlaps {other.GetName2()!r}")
+
+
+@contextmanager
+def view_changes(native, path, doc, drawing, sheet, extension):
+    created = []
+    try:
+        yield created
+    except Exception as cause:
+        if created:
+            try:
+                native.document(path, 3)
+                activate_sheet(native, drawing, sheet)
+                for raw in reversed(created):
+                    name = native.cast(raw, "IView").GetName2()
+                    doc.ClearSelection2(True)
+                    if not select_view(extension, name) or not extension.DeleteSelection2(0):
+                        raise RuntimeError(f"SolidWorks did not delete {name!r}")
+                    if any(view.GetName2() == name for view in model_views(native, sheet)):
+                        raise RuntimeError(f"View {name!r} remains on the sheet")
+            except Exception as exc:
+                raise ZJZLError("rollback_failed", f"{cause}. View cleanup failed: {exc}") from exc
+        raise
+    finally:
+        doc.ClearSelection2(True)
+
+
+def _create(drawing_path, base_view, directions, offset_m, sheet_name, save):
+    path = source_path(drawing_path, (".slddrw",))
+    native = Native()
+    doc, drawing, sheet, extension = drawing_scope(native, path, sheet_name)
+    parent = named_view(native, sheet, base_view)
+    parent_matrix = transform(native, parent)
+    model_path = path_key(parent.GetReferencedModelName())
+    configuration = parent.ReferencedConfiguration
+    first_angle = bool(sheet.GetProperties2()[4])
+    positions = projection_positions(parent.Position, directions, offset_m, first_angle)
+    expected = {direction: tuple(SIDES[direction][1] * value for value in axis_vector(
+        parent_matrix, SIDES[direction][0])) for direction in positions}
+    for point in positions.values():
+        sheet_point(sheet, point)
+
+    existing = {}
+    for view in model_views(native, sheet):
+        if view.Type != 4:  # swDrawingProjectedView
+            continue
+        base = native.cast(view.GetBaseView(), "IView")
+        if base is None or base.GetName2() != base_view:
+            continue
+        normal = axis_vector(transform(native, view), 2)
+        for direction, target in expected.items():
+            if math.dist(normal, target) < 1e-6:
+                raise ZJZLError("projection_exists", f"{direction!r} projection already exists as {view.GetName2()!r}")
+
+    activate_sheet(native, drawing, sheet)
+    with view_changes(native, path, doc, drawing, sheet, extension) as created:
+        for direction, point in positions.items():
+            doc.ClearSelection2(True)
+            if not drawing.ActivateView(base_view) or not select_view(extension, base_view):
+                raise ZJZLError("view_selection_failed", f"Could not select projection parent {base_view!r}")
+            raw = drawing.CreateUnfoldedViewAt3(*point, 0.0, False)
+            if raw is None:
+                raise ZJZLError("projection_failed", f"SolidWorks did not create the {direction!r} projection")
+            created.append(raw)
+            view = native.cast(raw, "IView")
+            doc.EditRebuild3()
+            matrix = transform(native, view)
+            actual_base = native.cast(view.GetBaseView(), "IView")
+            if (view.Type != 4 or actual_base is None or actual_base.GetName2() != base_view
+                    or path_key(view.GetReferencedModelName()) != model_path
+                    or view.ReferencedConfiguration != configuration
+                    or math.dist(axis_vector(matrix, 2), expected[direction]) > 1e-6
+                    or not math.isclose(matrix[12], parent_matrix[12], rel_tol=1e-6)
+                    or math.dist(view.Position[:2], point) > 0.001):
+                raise ZJZLError("projection_verification_failed", f"Native {direction!r} view readback differs from the request")
+            check_layout(native, sheet, view)
+            existing[direction] = {**view_record(view), "normal_model": list(axis_vector(matrix, 2))}
+        warnings = save_drawing(doc) if save else None
+    return {"drawing_path": path, "sheet": sheet.GetName(), "base_view": base_view,
+            "projection": "first" if first_angle else "third", "views": existing, "saved": save,
+            "save_warnings": warnings, "readback_verified": True}
+
+
+def create_orthographic_views(drawing_path, base_view, directions, offset_m, sheet, save):
+    return execute(_create, drawing_path, base_view, directions, offset_m, sheet, save)
diff --git a/src/solidworks_assetmate_mechdog/tools/zjzl_reference_dimension.py b/src/solidworks_assetmate_mechdog/tools/zjzl_reference_dimension.py
new file mode 100644
index 0000000..d146379
--- /dev/null
+++ b/src/solidworks_assetmate_mechdog/tools/zjzl_reference_dimension.py
@@ -0,0 +1,147 @@
+"""Create driven drawing dimensions from verified native geometry references."""
+from __future__ import annotations
+
+import math
+
+from ..sw_session import call_method
+from .zjzl_geometry import component_transform, projected_span, resolve_visible, visible_components
+from .zjzl_native import (
+    Native, ZJZLError, activate_sheet, drawing_scope, execute, named_view, persist,
+    rollback_annotation, save_drawing, sheet_point, source_path,
+)
+from .zjzl_orthographic import axis_vector, transform
+
+
+# IDimension::GetType reports the unit family, IDisplayDimension::Type2 the style.
+OPERATIONS = {
+    "aligned": ("AddDimension2", {2, 9, 11, 12}),
+    "horizontal": ("AddHorizontalDimension2", {2, 11}),
+    "vertical": ("AddVerticalDimension2", {2, 12}),
+    "angular": ("AddDimension2", {3, 16}),
+    "diameter": ("AddDiameterDimension2", {6, 15}),
+    "radius": ("AddRadialDimension2", {5, 14}),
+}
+
+
+def _displays(native, view):
+    raw = view.GetFirstDisplayDimension5()
+    while raw is not None:
+        display = native.cast(raw, "IDisplayDimension")
+        yield display
+        raw = display.GetNext5()
+
+
+def attachments_match(native, annotation, entities):
+    attached = annotation.GetAttachedEntities3() or ()
+    return len(entities) == len(attached) and all(
+        any(native.app.IsSame(actual, entity) == 1 for actual in attached) for entity in entities
+    )
+
+
+def _validate_selection(native, kind, refs, entities, view, components):
+    if kind in ("diameter", "radius"):
+        if len(refs) != 1 or refs[0].kind != "edge":
+            raise ZJZLError("bad_input", "A radial dimension requires one circular edge")
+        edge = native.cast(entities[0], "IEdge")
+        curve = native.cast(edge.GetCurve(), "ICurve")
+        if curve is None or not curve.IsCircle():
+            raise ZJZLError("bad_input", "A radial dimension requires a circular edge")
+        normal = curve.CircleParams[3:6]
+        owner = components[refs[0].component][1]
+        matrix = component_transform(native, owner)
+        if matrix is not None:
+            normal = [sum(a * b for a, b in zip(normal, axis_vector(matrix, i))) for i in range(3)]
+        view_normal = axis_vector(transform(native, view), 2)
+        if not math.isclose(abs(sum(a * b for a, b in zip(normal, view_normal))), 1.0, abs_tol=1e-6):
+            raise ZJZLError("bad_input", "A radial dimension requires a face-on circular edge")
+        return
+    if kind != "angular" and len(refs) == 2 and all(ref.kind == "vertex" for ref in refs):
+        return
+    count = 2 if kind == "angular" else 1
+    if len(refs) == count and all(ref.kind == "edge" for ref in refs):
+        edges = [native.cast(entity, "IEdge") for entity in entities]
+        curves = [native.cast(edge.GetCurve(), "ICurve") for edge in edges]
+        if all(curve is not None and curve.IsLine() for curve in curves):
+            return
+    raise ZJZLError("bad_input", "Use two straight edges for angular dimensions, or one straight edge or two vertices for linear dimensions")
+
+
+def _add(drawing_path, view_name, kind, references, position_m, expected_value, tolerance, sheet_name, save):
+    if kind not in OPERATIONS or not 1 <= len(references) <= 2:
+        raise ZJZLError("bad_input", "Choose a supported dimension kind and one or two references")
+    if (not math.isfinite(tolerance) or tolerance < 0
+            or expected_value is not None and (not math.isfinite(expected_value) or expected_value < 0)):
+        raise ZJZLError("bad_input", "Expected value and tolerance must be finite and nonnegative")
+    path = source_path(drawing_path, (".slddrw",))
+    native = Native()
+    doc, drawing, sheet, extension = drawing_scope(native, path, sheet_name)
+    view = named_view(native, sheet, view_name)
+    sheet_name = sheet.GetName()
+    point = sheet_point(sheet, position_m)
+    components = visible_components(native, view)
+    entities = [resolve_visible(native, extension, view, components, ref, path, sheet_name, view_name)
+                for ref in references]
+    if len(entities) == 2 and native.app.IsSame(*entities) == 1:
+        raise ZJZLError("bad_input", "Do not use the same entity twice")
+    _validate_selection(native, kind, references, entities, view, components)
+    operation, styles = OPERATIONS[kind]
+    span = None
+    axes = {"horizontal": 0, "vertical": 1, "aligned": None}
+    if kind in axes:
+        span = projected_span(native, view, components, references, entities, axes[kind])
+        if span <= 1e-6:
+            raise ZJZLError("bad_input", "The references have zero projected separation for the requested kind")
+    for existing in _displays(native, view):
+        if (existing.Type2 in styles
+                and attachments_match(native, native.cast(call_method(existing, "GetAnnotation"), "IAnnotation"), entities)):
+            previous = native.cast(existing.GetDimension2(0), "IDimension")
+            if span is None or math.isclose(previous.SystemValue * 1000, span, abs_tol=0.01):
+                raise ZJZLError("dimension_exists", "A dimension of this type already references this geometry")
+
+    activate_sheet(native, drawing, sheet)
+    doc.ClearSelection2(True)
+    annotation = None
+    try:
+        if not drawing.ActivateView(view_name):
+            raise ZJZLError("view_selection_failed", f"Could not activate {view_name!r}")
+        for index, entity in enumerate(entities):
+            if not view.SelectEntity(entity, index > 0):
+                raise ZJZLError("entity_selection_failed", "Could not select the exact geometry in its view")
+        raw = getattr(doc, operation)(*point)
+        if raw is None:
+            raise ZJZLError("dimension_creation_failed", "SolidWorks did not create the dimension")
+        display = native.cast(raw, "IDisplayDimension")
+        annotation = native.cast(call_method(display, "GetAnnotation"), "IAnnotation")
+        dimension = native.cast(display.GetDimension2(0), "IDimension")
+        display.ShowParenthesis = True
+        unit = "deg" if kind == "angular" else "mm"
+        value = math.degrees(dimension.SystemValue) if unit == "deg" else dimension.SystemValue * 1000
+        identifier = persist(extension, display)
+        display_type, parameter_type, driven_state = display.Type2, dimension.GetType(), dimension.DrivenState
+        if display_type not in styles or parameter_type != (1 if unit == "deg" else 0) or driven_state != 1:
+            raise ZJZLError("dimension_verification_failed",
+                            f"Unexpected native dimension type={display_type}, parameter_type={parameter_type}, driven_state={driven_state}")
+        if (not display.ShowParenthesis or annotation.IsDangling() or annotation.Visible != 1 or not identifier
+                or not attachments_match(native, annotation, entities)
+                or not any(native.app.IsSame(display, d) == 1 for d in _displays(native, view))):
+            raise ZJZLError("dimension_verification_failed", "Could not verify the native dimension visibility, persistence or view attachments")
+        if not math.isfinite(value) or span is not None and not math.isclose(value, span, abs_tol=0.01):
+            raise ZJZLError("dimension_verification_failed", f"Read {value:g} {unit}, projected separation is {span} {unit}")
+        if expected_value is not None and abs(value - expected_value) > tolerance:
+            raise ZJZLError("dimension_value_mismatch", f"Read {value:g} {unit}, expected {expected_value} ± {tolerance:g}")
+        record = {"drawing_path": path, "sheet": sheet_name, "view": view_name, "dimension_id": identifier,
+                  "name": dimension.FullName, "kind": kind, "reference": True, "value": value, "unit": unit,
+                  "position_m": list(annotation.GetPosition()[:2]),
+                  "attachments": [ref.model_dump() for ref in references], "readback_verified": True}
+        warnings = save_drawing(doc) if save else None
+        return {**record, "saved": save, "save_warnings": warnings}
+    except Exception as exc:
+        if annotation is not None:
+            rollback_annotation(doc, extension, annotation, exc)
+        raise
+    finally:
+        doc.ClearSelection2(True)
+
+
+def add_reference_dimension(drawing_path, view_name, kind, references, position_m, expected_value, tolerance, sheet, save):
+    return execute(_add, drawing_path, view_name, kind, references, position_m, expected_value, tolerance, sheet, save)
