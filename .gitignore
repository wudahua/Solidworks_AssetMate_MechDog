# SolidWorks / CAD binaries — never commit user models
*.SLDPRT
*.SLDASM
*.SLDDRW
*.sldprt
*.sldasm
*.slddrw
*.bmp
*.step
*.stp
*.x_t

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# vim swap files. NOTE: SolidWorks VBA macros also use .swp — if a real macro ever
# needs to ship, exclude it explicitly with !path/to/file.swp and add package-data.
*.swp

# OS / editors
Thumbs.db
.DS_Store
.vscode/
.idea/

# Local env / secrets
.env
*.token

# Test fixtures are LOCAL-ONLY (README says so, and the CAD rules above only cover model
# files). zip / PNG / JPG / CSV slipped through and got published — four rounds of reports.
# Whole tree on purpose: nothing under 测试用例/ belongs in the package.
测试用例/

# Local handover materials (contains its own git repo; not published)
recolor-GitHub-交接/

# Local review/feedback notes — working material, not part of the published package
用户反馈问题/

# Runtime failure logs (sw_session.log_dir writes here from the current directory).
# They are diagnostics for the machine that ran the tool, never part of the package.
logs/

# Handoff bundles live under 项目规划/handoff/ — never at the repo root
*.zip

# Local working material (planning docs, handoff packs, probe scripts)
项目规划 - AssetMate_MechDog/
_probe_*.py

# Performance baselines are local measurements, not source
logs/perf*.jsonl
